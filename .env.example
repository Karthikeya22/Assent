# Copy to .env (repo root). Read by apps/api settings and apps/web.
DATABASE_URL=postgresql+asyncpg://assent:assent@localhost:5432/assent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-only-32-bytes-minimum!!
JWT_TTL_MINUTES=15
EMBED_DIM=384
CORS_ORIGINS=["http://localhost:3000"]

# LLM (Phase 1+)
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# web
API_URL=http://localhost:8000
AUTH_SECRET=change-me-dev-only
AUTH_TRUST_HOST=true
